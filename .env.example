# URL pública do site (canonical e OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# Destino real do formulário de contato (POST JSON). Sem ele, o site informa
# que o envio não está disponível e nenhum dado é enviado.
CONTACT_FORM_ENDPOINT=
# Opcional: enviado como "Authorization: Bearer <token>"
CONTACT_FORM_TOKEN=

# CRM (/crm) — passo a passo em docs/crm/README.md
# E-mails Google que podem entrar no CRM, separados por vírgula
CRM_ADMIN_EMAILS=
# Cliente OAuth do Google Cloud (login com Google)
CRM_GOOGLE_CLIENT_ID=
CRM_GOOGLE_CLIENT_SECRET=
# ID da planilha (o trecho entre /d/ e /edit no link do Google Sheets)
CRM_SHEET_ID=
# Apps Script da planilha (docs/crm/apps-script.gs): URL do app da Web e chave gerada por gerarChave
CRM_APPS_SCRIPT_URL=
CRM_APPS_SCRIPT_SECRET=
# Alternativa ao Apps Script: conteúdo inteiro do .json de uma conta de serviço do Google
# CRM_SERVICE_ACCOUNT_JSON=
# Opcional: assina o cookie de sessão (32+ caracteres). Sem ela, deriva da chave do cliente OAuth
# CRM_SESSION_SECRET=
# Banco do CRM no Supabase (docs/crm/README.md, seção Supabase). Com as duas preenchidas, o CRM
# usa o Supabase no lugar da planilha e o formulário de contato vira lead automaticamente.
SUPABASE_URL=
# Chave secreta (service_role ou sb_secret_...). Só no servidor: nunca use NEXT_PUBLIC_ aqui.
SUPABASE_SERVICE_ROLE_KEY=
# Só no seu computador: entra sem Google e usa .crm-dev.json no lugar da planilha
# CRM_DEV_LOGIN=1
