# URL pública do site (canonical e OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# Destino real do formulário de contato (POST JSON). Sem ele, o site informa
# que o envio não está disponível e nenhum dado é enviado.
CONTACT_FORM_ENDPOINT=
# Opcional: enviado como "Authorization: Bearer <token>"
CONTACT_FORM_TOKEN=
